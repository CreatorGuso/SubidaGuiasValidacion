# Copia este archivo como .env y completa los valores de tu entorno.
# NO subas el .env real: esta en .gitignore.

# --- BD central (admin) ---
DB_SERVER=serverXX
DB_DATABASE=admin
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_ENCRYPTION=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=120000

# --- SUNAT ---
SUNAT_MODO=beta
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_CERTIFICADO_PATH=
SUNAT_CERTIFICADO_PASSWORD=

# --- Certificados ---
# Carpeta local con los .pfx de cada RUC (no se versiona).
CERTIFICATES_DIR=./certificates

# --- Proceso ---
POLL_TICKET_MAX_INTENTOS=20
POLL_TICKET_INTERVAL_MS=5000

# --- Reporte de pendientes ---
REPORTE_DIR=./reportes
REPORTE_ARCHIVO=pendientes.json